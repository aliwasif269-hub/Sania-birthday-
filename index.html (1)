<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#170c2b"><title>For Sania ♡</title><style>
:root{--p:#ff8dc7;--r:#ff4fa0;--g:#ffe5ac;--w:#fff7ff}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at top,#593064,#25133d 38%,#10091e 80%);color:var(--w);font-family:Georgia,serif;overflow-x:hidden}button{font:inherit;cursor:pointer}#stars,#floaters{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:0}.star{position:absolute;background:white;border-radius:50%;box-shadow:0 0 9px #ffc6ec;animation:tw 2.5s infinite alternate}@keyframes tw{to{opacity:.15;transform:scale(.5)}}main{position:relative;z-index:1}.hero{min-height:100svh;display:grid;place-items:center;text-align:center;padding:25px 18px;position:relative}.k{font:700 .68rem Arial;letter-spacing:.25em;text-transform:uppercase;color:var(--g)}h1{font-size:clamp(3.6rem,15vw,8rem);font-weight:400;line-height:.9;letter-spacing:-.06em;margin:24px 0}h1 em{display:block;color:var(--p);text-shadow:0 0 32px #ff4fa055}.sub{max-width:470px;margin:0 auto 27px;color:#e8d8f1;line-height:1.85}.btn{border:1px solid #ffc4e866;border-radius:99px;padding:15px 24px;color:white;background:linear-gradient(115deg,#ff5fa8,#a56dff);box-shadow:0 0 28px #ff5fa844}.hint{font: .72rem Arial;letter-spacing:.1em;color:#c7add5;margin-top:15px}.section{max-width:820px;margin:auto;padding:66px 18px}.eyebrow{text-align:center;color:var(--g);font: .68rem Arial;letter-spacing:.25em;text-transform:uppercase;margin-bottom:12px}h2{text-align:center;font-weight:400;font-size:clamp(2.2rem,8vw,4rem);margin:0 0 14px}h2 em{color:var(--p)}.intro{text-align:center;line-height:1.8;color:#d5c2e3;max-width:560px;margin:0 auto 28px}.glass{border:1px solid #ffffff22;border-radius:27px;padding:clamp(24px,6vw,42px);background:linear-gradient(135deg,#ffffff12,#ffffff05);box-shadow:0 25px 80px #0002;backdrop-filter:blur(12px)}.letter{font-size:1.06rem;line-height:2;white-space:pre-line;color:#f7eaf8}.letter strong{color:var(--p);font-weight:400;font-style:italic}.giftarea{text-align:center;min-height:250px}.gift{border:0;background:transparent;font-size:clamp(7rem,27vw,11rem);filter:drop-shadow(0 12px 26px #ff5fa855);animation:bob 2.5s infinite}.secret{display:none;max-width:540px;margin:auto}.secret.show{display:block;animation:rise .8s ease both}@keyframes rise{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}@keyframes bob{50%{transform:translateY(-10px) rotate(3deg)}}.heart{font-size:3.5rem;animation:beat 1.3s infinite}@keyframes beat{15%,45%{transform:scale(1.15)}30%,60%,100%{transform:scale(1)}}.count{display:flex;justify-content:center;margin:25px 0}.time{min-width:84px;border:1px solid #ffffff20;background:#ffffff0a;border-radius:19px;padding:16px 10px;text-align:center}.time b{display:block;color:var(--g);font-size:2.4rem;font-weight:400}.time span{font: .65rem Arial;letter-spacing:.15em;color:#d7c2e6;text-transform:uppercase}.reveal{display:none;text-align:center}.reveal.show{display:block;animation:rise .8s ease both}.balloon-stage{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;align-items:end;margin:28px auto 20px;max-width:620px}.balloon{position:relative;border:0;background:transparent;padding:0 0 24px;min-width:0;animation:balloonFloat 2.3s ease-in-out infinite alternate;transition:transform .18s,opacity .25s}.balloon:nth-child(2n){animation-delay:-1s}.balloon:nth-child(3n){animation-delay:-.5s}.balloon-shape{display:grid;place-items:center;margin:auto;width:clamp(44px,13vw,82px);height:clamp(56px,16vw,100px);border-radius:52% 48% 48% 52%/42% 42% 58% 58%;color:#fff;font:700 clamp(14px,4vw,22px) Arial;box-shadow:inset -9px -8px 15px #0002,inset 8px 8px 15px #ffffff45,0 10px 25px #ff76bd22;position:relative}.balloon-shape:after{content:"";position:absolute;bottom:-7px;left:calc(50% - 5px);border-left:5px solid transparent;border-right:5px solid transparent;border-top:9px solid var(--balloon)}.balloon:before{content:"";position:absolute;left:50%;bottom:0;height:25px;border-left:1px solid #ffffff8a}.balloon.popped{transform:scale(1.65);opacity:0;pointer-events:none;animation:none}.pop-burst{position:fixed;z-index:30;pointer-events:none;font-size:20px;animation:burst .75s ease-out forwards}@keyframes burst{to{transform:translate(var(--dx),var(--dy)) scale(.2) rotate(180deg);opacity:0}}.final-note{display:none;margin:18px auto 0;max-width:560px;padding:22px;border:1px solid #ffb9e577;border-radius:22px;background:linear-gradient(135deg,#ff6ba922,#a56dff22);text-align:center}.final-note.show{display:block;animation:rise .9s ease both}.final-note .big{font-size:2.7rem}.balloon-message{min-height:78px;text-align:center;color:#ffe8f7;line-height:1.7;padding:15px;border-radius:18px;background:#ffffff0b;border:1px solid #ffffff17}.balloon-message b{color:var(--g);font-weight:400}.pop-hint{text-align:center;font: .7rem Arial;letter-spacing:.12em;color:#d6bce7}@keyframes balloonFloat{to{transform:translateY(-9px) rotate(2deg)}}.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.memory{aspect-ratio:4/5;min-height:140px;border:1px solid #ffffff26;border-radius:22px;background:linear-gradient(145deg,#ffacd52b,#ad8bff24);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px}.memory b{font-size:2.5rem;font-weight:400}.memory span{font: .72rem Arial;color:#e7d4ef}footer{text-align:center;padding:35px 18px 70px;color:#bda4ce;font: .75rem Arial;letter-spacing:.06em}.float{position:absolute;bottom:-40px;animation:up linear forwards;opacity:.85}@keyframes up{to{transform:translateY(-110vh) rotate(50deg);opacity:0}}.music{position:fixed;right:13px;bottom:13px;z-index:10;border:1px solid #ffffff2e;border-radius:99px;padding:12px 16px;background:#29183de8;color:white;box-shadow:0 8px 30px #0004;font: .78rem Arial}@media(max-width:560px){.section{padding:54px 16px}.gallery{grid-template-columns:repeat(2,1fr)}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;scroll-behavior:auto!important}}
</style></head><body><div id="stars"></div><div id="floaters"></div><main><section class="hero"><div><div class="k">A tiny universe, only for you</div><h1>Happy Birthday<em>Sania ♡</em></h1><p class="sub">A little world of wishes is waiting for you. Pop the balloons, unlock hidden messages, and open the final surprise made just for you. 🎀</p><button class="btn" id="begin">Start the surprise · 🎈</button><div class="hint">MADE WITH A LITTLE EXTRA LOVE</div></div></section>
<section class="section" id="letter"><div class="eyebrow">A note from my heart</div><h2>For you, <em>Sania</em></h2><p class="intro">Some feelings deserve more than a quick birthday text.</p><div class="glass letter">Dear <strong>Sania</strong>,

On your birthday, I hope life gives you more than beautiful words. I hope it gives you peace on the days your heart feels tired, courage when the next step feels uncertain, and happiness that stays long after a moment has passed.

I hope you find people who understand your silence, laughter that arrives when you need it most, and little reasons to believe that the world can be kind. When life gets loud, may you always find a quiet place where you feel safe, valued, and completely yourself.

You deserve the kind of joy that feels like sunlight through a window — gentle, warm, and impossible not to notice. May this new year bring you closer to the dreams you keep quietly in your heart.

<strong>And whenever you forget how special you are, I hope life finds a thousand small ways to remind you.</strong>

Happy Birthday, Sania. May your wishes find their way to you, one by one. ♡</div></section>
<section class="section" id="balloon-magic"><div class="eyebrow">A tiny birthday game</div><h2>Pop a balloon, <em>find a wish</em></h2><p class="intro">Har balloon ke andar Sania ke liye ek chhoti si baat chhupi hai. Tap karke phoro — dekho tumhare liye kya nikla. 🎈</p><div class="glass"><div class="balloon-stage" id="balloonStage"><button class="balloon" style="--balloon:#ff6ba9" aria-label="Pop balloon 1"><span class="balloon-shape" style="--balloon:#ff6ba9;background:linear-gradient(135deg,#ff8ec4,#e93d8b)">♡</span></button><button class="balloon" style="--balloon:#9e7bff" aria-label="Pop balloon 2"><span class="balloon-shape" style="--balloon:#9e7bff;background:linear-gradient(135deg,#c3aaff,#7850e8)">✦</span></button><button class="balloon" style="--balloon:#ffbd6b" aria-label="Pop balloon 3"><span class="balloon-shape" style="--balloon:#ffbd6b;background:linear-gradient(135deg,#ffdc9c,#f48c42)">♡</span></button><button class="balloon" style="--balloon:#62cfc9" aria-label="Pop balloon 4"><span class="balloon-shape" style="--balloon:#62cfc9;background:linear-gradient(135deg,#9bf3e5,#28a9b3)">✧</span></button><button class="balloon" style="--balloon:#ff7890" aria-label="Pop balloon 5"><span class="balloon-shape" style="--balloon:#ff7890;background:linear-gradient(135deg,#ffa3b5,#ef4f71)">♡</span></button></div><div class="pop-hint" id="popHint">TAP EACH BALLOON TO REVEAL A SECRET WISH</div><div class="balloon-message" id="balloonMessage">Your first little surprise is waiting… <b>pop a balloon!</b></div><div class="final-note" id="finalNote"><div class="big">💌✨🎂</div><h3 style="font-size:1.8rem;font-weight:400;margin:8px 0">Sania, this last wish is from the heart</h3><p style="line-height:1.9;color:#f5e5f7;margin:0">I hope life gives you a hundred reasons to smile when you least expect them, the courage to chase every dream, and people who make you feel loved without having to ask. You deserve beautiful things — not just today, but every day. <strong style="color:#ffb9df;font-weight:400">Happy Birthday, Sania. ♡</strong></p></div></div></section>
<section class="section"><div class="eyebrow">A little magic</div><h2>Open your <em>gift</em></h2><p class="intro">This little box is holding one more message just for you. Tap it to open. 🎁</p><div class="glass giftarea"><button class="gift" id="gift" aria-label="Open birthday gift">🎁</button><div class="hint" id="ghint">TAP THE GIFT BOX</div><div class="secret" id="secret"><div class="heart">💗</div><h3 style="font-size:2rem;font-weight:400">One little wish for you</h3><p style="line-height:1.9;color:#ead8f3">May you always be surrounded by people who choose you with kindness, celebrate your smallest wins, and remind you that your heart deserves beautiful things. Today is yours, Sania. Let yourself feel special. ✨</p><div style="font-size:1.8rem">🌷 🎀 🌷</div></div></div></section>
<section class="section"><div class="eyebrow">Ready for the final wish?</div><h2>Three seconds to <em>magic</em></h2><p class="intro">Take a breath. Make a wish. This moment is for you.</p><div class="glass" style="text-align:center"><div class="count" id="count"><div class="time"><b id="sec">3</b><span>seconds</span></div></div><div class="reveal" id="reveal"><div style="font-size:4rem;animation:bob 1.8s infinite">🎂</div><h3 style="font-size:2.3rem;font-weight:400">Happy Birthday, Sania!</h3><p style="line-height:1.9;color:#ead8f3">May the year ahead be softer than your worries, brighter than your fears, and full of memories your heart will keep forever. Keep shining, beautiful soul. ♡</p><button class="btn" id="sparkle">Make it sparkle ✨</button><p id="sparkmsg" style="color:var(--g)"></p></div></div></section>
<section class="section"><div class="eyebrow">Little keepsakes</div><h2>A gallery of <em>good wishes</em></h2><p class="intro">No photos needed — just a few little symbols for all the lovely memories still waiting to happen.</p><div class="gallery"><div class="memory"><b>🌷</b><span>Gentle days</span></div><div class="memory"><b>🧁</b><span>Sweet moments</span></div><div class="memory"><b>🦋</b><span>New beginnings</span></div></div></section><footer>FOR SANIA ♡ · A LITTLE PAGE FULL OF WISHES</footer></main><button class="music" id="music">♫ Play your song</button><audio id="audio" loop preload="none"><source src="song.mp3" type="audio/mpeg"></audio>
<script>const sb=document.getElementById('stars');for(let i=0;i<95;i++){let s=document.createElement('i');s.className='star';s.style.left=Math.random()*100+'%';s.style.top=Math.random()*100+'%';s.style.width=s.style.height=(1+Math.random()*3)+'px';s.style.animationDelay=Math.random()*4+'s';s.style.animationDuration=(2+Math.random()*4)+'s';sb.appendChild(s)}function floaties(n=18){let b=document.getElementById('floaters');for(let i=0;i<n;i++){let e=document.createElement('span');e.className='float';e.textContent=['♡','♥','✦','🎀','✨','🌸'][Math.floor(Math.random()*6)];e.style.left=Math.random()*100+'%';e.style.fontSize=(12+Math.random()*22)+'px';e.style.animationDuration=(5+Math.random()*6)+'s';b.appendChild(e);setTimeout(()=>e.remove(),12000)}}setInterval(()=>floaties(3),1900);document.querySelectorAll('.balloon').forEach((balloon,i)=>{balloon.addEventListener('click',()=>{if(balloon.classList.contains('popped'))return;const wishes=['May your smile always find a reason to stay. ♡','You deserve the same kindness you give to others. 🌷','May your biggest dreams slowly become your real life. ✨','I hope this year brings you peace, laughter, and lovely surprises. 🦋','And one last thing, Sania: you make ordinary moments feel special. 💗'];const r=balloon.getBoundingClientRect();for(let j=0;j<10;j++){let burst=document.createElement('span');burst.className='pop-burst';burst.textContent=['✦','♡','✨','•'][j%4];burst.style.left=(r.left+r.width/2)+'px';burst.style.top=(r.top+r.height/2)+'px';burst.style.setProperty('--dx',(Math.random()*150-75)+'px');burst.style.setProperty('--dy',(Math.random()*150-75)+'px');document.body.appendChild(burst);setTimeout(()=>burst.remove(),800)}balloon.classList.add('popped');document.getElementById('balloonMessage').innerHTML='<b>Wish '+(i+1)+' of 5</b><br>'+wishes[i];floaties(12);const left=[...document.querySelectorAll('.balloon')].filter(x=>!x.classList.contains('popped')).length;document.getElementById('popHint').textContent=left?left+' MORE LITTLE WISH'+(left===1?'':'ES')+' WAITING':'ALL WISHES UNLOCKED — YOU DESERVE EVERY ONE ♡';if(!left){setTimeout(()=>{document.getElementById('balloonMessage').innerHTML='<b>All five wishes are yours! ♡</b><br>But wait… there is one last message below, just for you. 🎂';document.getElementById('finalNote').classList.add('show');document.getElementById('finalNote').scrollIntoView({behavior:'smooth',block:'center'});floaties(55)},450)}})});document.getElementById('begin').onclick=()=>{document.getElementById('balloon-magic').scrollIntoView({behavior:'smooth'});floaties(28)};document.getElementById('gift').onclick=()=>{document.getElementById('gift').style.display='none';document.getElementById('ghint').style.display='none';document.getElementById('secret').classList.add('show');floaties(45)};let n=3,t=setInterval(()=>{n--;document.getElementById('sec').textContent=n;if(n<=0){clearInterval(t);document.getElementById('count').style.display='none';document.getElementById('reveal').classList.add('show');floaties(35)}},1000);document.getElementById('sparkle').onclick=()=>{floaties(65);document.getElementById('sparkmsg').textContent='✨ The world is a little brighter because you are in it. ♡'};const a=document.getElementById('audio'),m=document.getElementById('music');m.onclick=async()=>{if(a.paused){try{await a.play();m.textContent='♫ Pause song'}catch(e){m.textContent='♫ Upload song.mp3 first'}}else{a.pause();m.textContent='♫ Play your song'}};</script></body></html>
